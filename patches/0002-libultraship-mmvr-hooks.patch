+// Native diagnostic entry point: step only non-drawing resource commands using
+// the real dispatcher, without submitting another XR frame or changing its stack.
+void Interpreter::TestTriangleRunCommands(F3DGfx* commands, size_t count) {
+    const char* test = std::getenv("MMVR_NATIVE_TEST");
+    if (!test || std::strcmp(test, "1") != 0 || !commands) return;
+    struct RestoreStack {
+        GfxExecStack saved = std::move(g_exec_stack);
+        ~RestoreStack() { g_exec_stack = std::move(saved); }
+    } restore;
+    CommandInterpreterScope scope(this);
+    BeginTriangleCommand(false);
+    g_exec_stack.start(commands);
+    for (size_t i = 0; i < count; ++i) gfx_step();
+    BeginTriangleCommand(false);
+}
+
+size_t Interpreter::TestStepResourceCommand(F3DGfx* command) {
+    const char* test = std::getenv("MMVR_NATIVE_TEST");
+    if (!test || std::strcmp(test, "1") != 0 || !command) return 0;
+    const auto opcode = int8_t(command->words.w0 >> 24);
+    if (opcode != OTR_G_VTX_OTR_HASH && opcode != OTR_G_VTX_OTR_FILEPATH &&
+        opcode != OTR_G_SETTIMG_OTR_HASH) return 0;
+    struct RestoreStack {
+        GfxExecStack saved = std::move(g_exec_stack);
+        ~RestoreStack() { g_exec_stack = std::move(saved); }
+    } restore;
+    CommandInterpreterScope scope(this);
+    g_exec_stack.start(command);
+    gfx_step();
+    return size_t(g_exec_stack.currCmd() - command);
+}
