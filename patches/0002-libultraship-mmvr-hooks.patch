+        (uint64_t(G_ACMUX_TEXEL0)<<16)|(uint64_t(G_ACMUX_0)<<19)|
+        (uint64_t(G_ACMUX_SHADE)<<22)|(uint64_t(G_ACMUX_0)<<25);
