+bool Interpreter::CullTrianglePacket(F3DGfx*& command) {
+    // Never bypass state changes, native color/depth consumers, HUD, alternate
+    // microcodes, framebuffer effects or diagnostic reference rendering.
+    if (mmvr::MultiviewActive() || !nativeBoundsReplay || mFbActive || !mShaderStack.empty() || !mResolvedResourceCacheEnabled ||
+        ucode_handler_index != ucode_f3dex2 || !mmvr::PerspectivePass() ||
+        mmvr::CullingAuditEnabled() || mmvr::CullingReferenceEnabled()) return false;
+    return CullTrianglePacketGuarded(command,mmvr::CurrentCullingGuard());
+}
+bool Interpreter::CullTrianglePacketGuarded(F3DGfx*& command, mmvr::CullingGuard guard) {
+    if(!guard.active || !mResolvedResourceCacheEnabled) return false;
+    // A fully in-frustum first vertex prevents rejection of the entire packet.
+    // Avoid the cache lookup/packet scan for these common visible batches.
+    const unsigned first=(uint32_t(command->words.w0)>>16)&255;
+    if(first/2 < std::size(mRsp->loaded_vertices) && mRsp->loaded_vertices[first/2].clip_rej==0) return false;
+    auto found=mTrianglePackets.find(command);
+    if(found==mTrianglePackets.end()) {
+        if(mTrianglePackets.size()>=16384) return false;
+        found=mTrianglePackets.emplace(command,mmvr::CompileTrianglePacket(command)).first;
+    }
+    const auto& packet=found->second;
+    ++mmvr::cullingAudit.packetTests;
+    if(!mmvr::PacketOutsideGuard(packet,mRsp->loaded_vertices,std::size(mRsp->loaded_vertices),guard)) return false;
+    ++mmvr::cullingAudit.skippedPackets;
+    mmvr::cullingAudit.skippedPacketCommands+=packet.commands;
+    command+=packet.commands;
+    return true;
+}
