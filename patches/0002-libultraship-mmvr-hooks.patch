+// Transform the generated built-in vertex shader; fragment colors/fog still
+// receive independently prepared eye attributes. Custom shaders use fallback.
+static std::vector<MultiviewAttribute> MakeMultiviewShader(std::string& shader) {
+    const auto version=shader.find("#version 300 es");
+    if(version==std::string::npos)throw mmvr::MultiviewFallback("unsupported shader version");
+    shader.insert(version+15,"\n#extension GL_OVR_multiview2 : require\nlayout(num_views=2) in;\n");
+    const std::regex declaration(R"(\bin\s+(float|vec2|vec3|vec4)\s+(a[A-Za-z0-9_]+)\s*;)");
+    std::vector<MultiviewAttribute> attributes;
+    std::string converted;size_t cursor=0;
+    for(auto it=std::sregex_iterator(shader.begin(),shader.end(),declaration);it!=std::sregex_iterator();++it){
+        const auto& match=*it;const std::string type=match[1],name=match[2];
+        attributes.push_back({name,type=="float" ? 1u : unsigned(type.back()-'0')});
+        converted+=shader.substr(cursor,match.position()-cursor);
+        converted+="in "+type+" "+name+"Eye0;\nin "+type+" "+name+"Eye1;\n";
+        converted+="#define "+name+" (gl_ViewID_OVR == 0u ? "+name+"Eye0 : "+name+"Eye1)\n";
+        cursor=match.position()+match.length();
+    }
+    converted+=shader.substr(cursor);
+    GLint maximum=0;glGetIntegerv(GL_MAX_VERTEX_ATTRIBS,&maximum);
+    if(attributes.empty() || attributes.size()*2>size_t(maximum) || attributes.size()*2>32)
+        throw mmvr::MultiviewFallback("vertex attribute limit");
+    shader=std::move(converted);return attributes;
+}
+#endif
