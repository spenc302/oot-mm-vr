+    // A cache reload must release driver objects and invalidate pointer-based
+    // binding caches before map storage can be reused by a new program.
+    UnloadShader(mLastLoadedShader);
+    GLint bound = 0;
+    glGetIntegerv(GL_CURRENT_PROGRAM, &bound);
+#if defined(MMVR_ENABLE) && defined(__ANDROID__)
+    glBindVertexArray(mOpenglVao);
+#endif
+    for (const auto& entry : mShaderProgramPool) {
+#if defined(MMVR_ENABLE) && defined(__ANDROID__)
