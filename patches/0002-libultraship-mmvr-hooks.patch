+    // entry and map fallback must recover the original object in both orders.
+    ColorCombinerKey collision=base;bool collisionFound=false;
+    for(uint64_t id=1;id<4096;++id){
+        collision.options=id<<SHADER_ID_SHIFT;
+        if(ColorCombinerFrontIndex(collision)==ColorCombinerFrontIndex(base)){collisionFound=true;break;}
+    }
+    auto* collisionNode=probe.LookupOrCreateColorCombiner(collision);
+    const auto beforeCollision=probe.mColorCombinerCacheDiagnostics;
+    bool collisions=collisionFound&&collisionNode!=original;
+    for(unsigned i=0;i<32;++i){
+        collisions&=probe.LookupOrCreateColorCombiner(base)==original;
+        collisions&=probe.LookupOrCreateColorCombiner(collision)==collisionNode;
+    }
+    collisions&=probe.mColorCombinerCacheDiagnostics.collisions==beforeCollision.collisions+64 &&
+        probe.mColorCombinerCacheDiagnostics.mapHits==beforeCollision.mapHits+64 &&
+        probe.mColorCombinerCacheDiagnostics.misses==beforeCollision.misses;
+
+    // Grow the authoritative map substantially and compare every generated
+    // field to the original lookup algorithm, including all cached addresses.
+    std::vector<ColorCombinerKey> keys;keys.reserve(512);
+    std::vector<ColorCombiner*> addresses;addresses.reserve(512);
+    bool baselineEquivalent=true;
+    for(uint64_t id=0;id<512;++id){
+        ColorCombinerKey key=base;key.options=id<<SHADER_ID_SHIFT;
+        if(id&1)key.options|=SHADER_OPT(_2CYC)|SHADER_OPT(ALPHA);
+        if(id&2)key.options|=SHADER_OPT(FOG);
+        keys.push_back(key);
+        auto* actual=probe.LookupOrCreateColorCombiner(key);addresses.push_back(actual);
+        auto* expected=baseline.LookupOrCreateColorCombinerImpl<false>(key);
+        baselineEquivalent&=CombinerProbeEqual(*actual,*expected);
+    }
+    bool poolGrowth=true;
+    for(size_t i=keys.size();i-- >0;){
+        auto* actual=probe.LookupOrCreateColorCombiner(keys[i]);
+        poolGrowth&=actual==addresses[i]&&actual==&probe.mColorCombinerPool.at(keys[i]);
+        baselineEquivalent&=CombinerProbeEqual(*actual,*baseline.LookupOrCreateColorCombinerImpl<false>(keys[i]));
+    }
+
+    probe.ColorCombinerCacheClear();
+    bool clearReload=probe.mColorCombinerPool.empty()&&probe.mPrevCombiner==probe.mColorCombinerPool.end();
+    for(const auto& entry:probe.mColorCombinerFront)clearReload&=!entry.valid;
+    const auto beforeReload=probe.mColorCombinerCacheDiagnostics;
+    auto* reloaded=probe.LookupOrCreateColorCombiner(base);
+    ColorCombiner regenerated{};GenerateCC(&regenerated,base);
+    clearReload&=reloaded==&probe.mColorCombinerPool.at(base)&&CombinerProbeEqual(*reloaded,regenerated)&&
+        probe.mColorCombinerCacheDiagnostics.misses==beforeReload.misses+1&&
+        probe.mColorCombinerCacheDiagnostics.frontHits==beforeReload.frontHits&&
+        probe.mColorCombinerCacheDiagnostics.immediateHits==beforeReload.immediateHits;
+    // Deliberately do not compare old pointer values after clear: the allocator
+    // may legitimately reuse their addresses for these new objects.
+    probe.ColorCombinerCacheClear();probe.ColorCombinerCacheClear();
+    clearReload&=probe.mColorCombinerPool.empty();
+    for(const auto& entry:probe.mColorCombinerFront)clearReload&=!entry.valid;
+    clearReload&=CombinerProbeEqual(*probe.LookupOrCreateColorCombiner(collision),
+                                   *baseline.LookupOrCreateColorCombinerImpl<false>(collision));
+
+    // Counters are opt-in diagnostics, not writes on the ordinary rendering path.
+    probe.mColorCombinerCacheDiagnosticsEnabled=false;
+    const auto gatedBefore=probe.mColorCombinerCacheDiagnostics;
+    probe.LookupOrCreateColorCombiner(base);probe.LookupOrCreateColorCombiner(base);
+    probe.ColorCombinerCacheClear();
+    const auto& gatedAfter=probe.mColorCombinerCacheDiagnostics;
+    const bool diagnosticsGated=gatedBefore.immediateHits==gatedAfter.immediateHits&&
+        gatedBefore.frontHits==gatedAfter.frontHits&&gatedBefore.mapHits==gatedAfter.mapHits&&
+        gatedBefore.misses==gatedAfter.misses&&gatedBefore.collisions==gatedAfter.collisions&&
+        gatedBefore.clears==gatedAfter.clears;
+
+    // Microbenchmark a disclosed repeated 32-material working set in a 512-
+    // material pool. It measures lookup work only, not gameplay FPS. Counters
+    // are off for both paths; alternating run order reduces thermal/order bias.
+    Interpreter fastBench,baselineBench;
+    fastBench.mColorCombinerCacheDiagnosticsEnabled=false;
+    baselineBench.mColorCombinerCacheDiagnosticsEnabled=false;
+    std::array<bool,COLOR_COMBINER_FRONT_SIZE> selectedBuckets{};
+    std::vector<ColorCombinerKey> hotKeys;
+    for(const auto& key:keys){
+        fastBench.LookupOrCreateColorCombiner(key);
+        baselineBench.LookupOrCreateColorCombinerImpl<false>(key);
+        const auto index=ColorCombinerFrontIndex(key);
+        if(hotKeys.size()<32&&!selectedBuckets[index]){selectedBuckets[index]=true;hotKeys.push_back(key);}
+    }
+    for(const auto& key:hotKeys){fastBench.LookupOrCreateColorCombiner(key);baselineBench.LookupOrCreateColorCombinerImpl<false>(key);}
+    constexpr unsigned iterations=100000,rounds=5;
+    std::array<double,rounds> baselineNs{},fastNs{};
+    bool benchmarkValid=hotKeys.size()==32;uint64_t baselineChecksum=0,fastChecksum=0;
+    auto measure=[&]<bool Fast>(Interpreter& owner,uint64_t& result){
+        uint64_t checksum=0;
+        const auto begin=std::chrono::steady_clock::now();
+        for(unsigned i=0;i<iterations;++i){
+            auto* value=owner.LookupOrCreateColorCombinerImpl<Fast>(hotKeys[i%hotKeys.size()]);
+            checksum+=value->shader_id0^(value->shader_id1+uint64_t(i));
+        }
+        const auto end=std::chrono::steady_clock::now();
+        result=checksum;
+        return std::chrono::duration<double,std::nano>(end-begin).count()/iterations;
+    };
+    for(unsigned round=0;round<rounds;++round){
+        if(round&1){
+            fastNs[round]=measure.template operator()<true>(fastBench,fastChecksum);
+            baselineNs[round]=measure.template operator()<false>(baselineBench,baselineChecksum);
+        }else{
+            baselineNs[round]=measure.template operator()<false>(baselineBench,baselineChecksum);
+            fastNs[round]=measure.template operator()<true>(fastBench,fastChecksum);
+        }
+        benchmarkValid&=baselineNs[round]>0&&fastNs[round]>0&&baselineChecksum==fastChecksum;
+    }
+    std::sort(baselineNs.begin(),baselineNs.end());std::sort(fastNs.begin(),fastNs.end());
+    const bool isolated=!probe.mRapi&&!baseline.mRapi&&!fastBench.mRapi&&!baselineBench.mRapi&&
+        probe.mBufVboLen==0&&baseline.mBufVboLen==0&&fastBench.mBufVboLen==0&&baselineBench.mBufVboLen==0;
+    const bool passed=sameKey&&alternating&&immediateAfterFront&&fullKey&&collisions&&generatedEquivalent&&
+        baselineEquivalent&&poolGrowth&&clearReload&&diagnosticsGated&&isolated&&benchmarkValid;
+    const char* session=std::getenv("MMVR_SESSION_TOKEN");const auto& c=probe.mColorCombinerCacheDiagnostics;
+    std::ofstream report("native-color-combiner-cache.json");
+    report<<"{\"session\":\""<<(session?session:"")<<"\",\"passed\":"<<passed<<",\"repeats\":"<<repeats
+        <<",\"sameKey\":"<<sameKey<<",\"alternating\":"<<alternating<<",\"immediateAfterFront\":"<<immediateAfterFront
+        <<",\"fullKey\":"<<fullKey<<",\"collisions\":"<<collisions<<",\"generatedEquivalent\":"<<generatedEquivalent
+        <<",\"baselineEquivalent\":"<<baselineEquivalent<<",\"poolGrowth\":"<<poolGrowth<<",\"clearReload\":"<<clearReload
+        <<",\"diagnosticsGated\":"<<diagnosticsGated<<",\"isolated\":"<<isolated<<",\"benchmarkValid\":"<<benchmarkValid
+        <<",\"immediateHits\":"<<c.immediateHits<<",\"frontHits\":"<<c.frontHits<<",\"mapHits\":"<<c.mapHits
+        <<",\"misses\":"<<c.misses<<",\"collisionCount\":"<<c.collisions<<",\"clears\":"<<c.clears
+        <<",\"benchmarkIterations\":"<<iterations<<",\"benchmarkRounds\":"<<rounds<<",\"benchmarkHotKeys\":"<<hotKeys.size()
+        <<",\"benchmarkPoolSize\":"<<keys.size()<<",\"baselineNsPerLookup\":"<<baselineNs[rounds/2]
+        <<",\"fastNsPerLookup\":"<<fastNs[rounds/2]<<",\"benchmarkChecksum\":"<<fastChecksum<<"}";
+    report.close();
+    if(!report)throw std::runtime_error("Could not write native color-combiner-cache report");
+    if(!passed)throw std::runtime_error("Native color-combiner front-cache regression failed");
+}
diff -ruN a/libultraship/src/fast/interpreter_geometry_culling.inc b/libultraship/src/fast/interpreter_geometry_culling.inc
--- a/libultraship/src/fast/interpreter_geometry_culling.inc	1970-01-01 00:00:00.000000000 +0000
+++ b/libultraship/src/fast/interpreter_geometry_culling.inc	2026-10-23 06:54:56.119780753 +0000
@@ -0,0 +1,78 @@
+// Included inside fast namespace. Archive resources are immutable during one
+// native tick; dynamic/segmented vertex storage deliberately uses the normal path.
+struct ArchiveGeometryResolver {
+    Interpreter& interpreter;
+    bool operator()(const F3DGfx* command, mmvr::GeometryLoad& load) const {
+        const unsigned op=uint32_t(command->words.w0)>>24;
+        const F3DVtx* vertices=nullptr;
+        size_t count=0, destination=0;
+        if (op==OTR_G_VTX_OTR_HASH) {
+            const uintptr_t offset=command->words.w1;
+            if (offset>0xFFFFF) return false; // Unowned cached/dynamic pointer.
+            count=(command->words.w0>>12)&255;
+            const size_t end=(command->words.w0>>1)&127;
+            if (end<count) return false;
+            destination=end-count;
+            const uint64_t hash=(uint64_t(command[1].words.w0)<<32)+command[1].words.w1;
+            auto raw=interpreter.ResolveResourceRawCached(hash);
+            if (!raw) return false;
+            vertices=reinterpret_cast<const F3DVtx*>(static_cast<const char*>(raw)+offset);
+        } else if (op==OTR_G_VTX_OTR_FILEPATH) {
+            const uintptr_t path=command->words.w1;
+            if (!PlausibleHostAddress(path)) return false;
+            count=command[1].words.w0; destination=command[1].words.w1>>16;
+            auto raw=interpreter.ResolveResourceRawCached(reinterpret_cast<const char*>(path));
+            if (!raw) return false;
+            vertices=static_cast<const F3DVtx*>(raw)+(command[1].words.w1&0xFFFF);
+        } else return false;
+        if (!count || destination>=68 || count>68-destination) return false;
+        load={vertices,uint16_t(count),uint16_t(destination),2};
+        return true;
+    }
+    static std::array<float,3> Position(const mmvr::GeometryLoad& load, unsigned index) {
+        const auto& v=static_cast<const F3DVtx*>(load.vertices)[index].v;
+        return {float(v.ob[0]),float(v.ob[1]),float(v.ob[2])};
+    }
+};
+bool Interpreter::CullGeometryRun(F3DGfx*& command) {
+    const uintptr_t address=reinterpret_cast<uintptr_t>(command);
+    if (address>mGeometryRunBegin && address<mGeometryRunEnd) return false;
+    if (!nativeBoundsReplay || mFbActive || !mShaderStack.empty() || !mResolvedResourceCacheEnabled ||
+        ucode_handler_index!=ucode_f3dex2 || !mmvr::PerspectivePass() ||
+        mmvr::CullingAuditEnabled() || mmvr::CullingReferenceEnabled()) return false;
+    if (mmvr::MultiviewActive() &&
+        (mRsp==&mStereoRsp || (mmvr::PairedVertexBenchEnabled() && mmvr::pairedVertexPackingReference))) return false;
+    mmvr::CullingGuard guard=mmvr::CurrentCullingGuard(), secondGuard{};
+    if (mmvr::MultiviewActive() && !mmvr::StereoCullingGuards(guard,secondGuard)) return false;
+    if (!guard.active) return false;
+    auto found=mGeometryRuns.find(command);
+    if (found==mGeometryRuns.end()) {
+        if (mGeometryRuns.size()>=16384) return false;
+        found=mGeometryRuns.emplace(command,mmvr::CompileGeometryRun(command,ArchiveGeometryResolver{*this})).first;
+    }
+    const auto& run=found->second;
+    if (run.commands) {
+        mGeometryRunBegin=address;
+        mGeometryRunEnd=reinterpret_cast<uintptr_t>(command+run.commands);
+    }
+    return CullGeometryRunGuarded(command,run,guard,
+                                  mmvr::MultiviewActive()?mStereoRsp.MP_matrix:nullptr,secondGuard);
+}
+bool Interpreter::CullGeometryRunGuarded(F3DGfx*& command, const mmvr::GeometryRun& run, mmvr::CullingGuard guard,
+                                         const float (*secondMatrix)[4], mmvr::CullingGuard secondGuard) {
+    if (!run.commands) return false;
+    ++mmvr::cullingAudit.packetTests;
+    if (secondMatrix) {
+        if (!mmvr::GeometryOutsideBothGuards(run,mRsp->MP_matrix,guard,secondMatrix,secondGuard)) return false;
+    } else if (!mmvr::GeometryOutsideGuard(run,mRsp->MP_matrix,guard)) return false;
+    // A later command may read any loaded vertex, including a previous range
+    // partly overwritten by the final load. Replay the minimal ordered writes
+    // that reconstruct ALL slots, not just the last vertex command.
+    for (const auto& load:run.retained)
+        GfxSpVertex(load.count,load.destination,static_cast<const F3DVtx*>(load.vertices));
+    ++mmvr::cullingAudit.skippedPackets;
+    mmvr::cullingAudit.skippedPacketCommands+=run.triangles;
+    mmvr::cullingAudit.skippedPacketVertices+=run.vertices-run.retainedVertices;
+    command+=run.commands;
+    return true;
+}
diff -ruN a/libultraship/src/fast/interpreter_lighting_capture_test.inc b/libultraship/src/fast/interpreter_lighting_capture_test.inc
--- a/libultraship/src/fast/interpreter_lighting_capture_test.inc	1970-01-01 00:00:00.000000000 +0000
+++ b/libultraship/src/fast/interpreter_lighting_capture_test.inc	2026-10-23 06:54:56.119790907 +0000
@@ -0,0 +1,120 @@
+// Included inside namespace Fast. Replays bounded scene-derived vertex inputs
+// without a GPU or game state. This is a CPU equivalence and cost check only.
+void Interpreter::VerifyCapturedLightingWorkload(const char* path) {
+    const char* diagnostic=std::getenv("MMVR_NATIVE_TEST");
+    if(!path||!diagnostic||std::strcmp(diagnostic,"1")!=0)
+        throw std::runtime_error("Lighting workload probe requires private native-test input");
+    std::ifstream input(path,std::ios::binary);
+    mmvr::LightingCaptureHeader header{};
+    input.read(reinterpret_cast<char*>(&header),sizeof(header));
+    const mmvr::LightingCaptureHeader expected{};
+    if(!input||std::memcmp(&header,&expected,sizeof(header)))
+        throw std::runtime_error("Lighting workload capture header/version mismatch");
+    std::vector<mmvr::LightingCaptureRecord> records;
+    std::array<uint32_t,10> poseCounts{};
+    mmvr::LightingCaptureRecord record{};
+    while(input.read(reinterpret_cast<char*>(&record),sizeof(record))){
+        if(records.size()>=5120||record.pose>=10||record.batch>=512||record.count==0||record.count>68||
+           record.dest>=68||record.count>68-record.dest||record.lightCount<1||record.lightCount>33||
+           (!records.empty()&&record.pose<records.back().pose))
+            throw std::runtime_error("Lighting workload capture record invalid or unbounded");
+        ++poseCounts[record.pose];
+        records.push_back(record);
+    }
+    if(input.gcount()!=0||records.empty())throw std::runtime_error("Lighting workload capture truncated or empty");
+    for(auto count:poseCounts)if(count<16||count>512)
+        throw std::runtime_error("Lighting workload capture missing or oversized pose");
+    using SourceBuffer=std::array<F3DVtx,MAX_VERTICES+4>;
+    auto makeProbe=[](){
+        auto probe=std::make_unique<Interpreter>();
+        probe->mSharedScenePreparation=true;
+        probe->mTextureCacheDiagnosticsEnabled=true;
+        probe->mFbActive=true;
+        probe->mActiveFrameBuffer=probe->mFrameBuffers.end();
+        probe->mCurDimensions.width=320;probe->mCurDimensions.height=240;
+        return probe;
+    };
+    auto prepare=[](Interpreter& probe,const mmvr::LightingCaptureRecord& item,F3DVtx* source){
+        auto* rsp=probe.mRsp;
+        rsp->geometry_mode=item.mode;
+        rsp->modelview_matrix_stack_size=1;
+        std::memcpy(rsp->modelview_matrix_stack[0],item.model,sizeof(item.model));
+        std::memcpy(rsp->MP_matrix,item.mp,sizeof(item.mp));
+        std::memcpy(rsp->current_lights,item.lights,sizeof(item.lights));
+        std::memcpy(rsp->lookat,item.lookat,sizeof(item.lookat));
+        rsp->current_num_lights=uint8_t(item.lightCount);
+        rsp->texture_scaling_factor.s=item.scaleS;
+        rsp->texture_scaling_factor.t=item.scaleT;
+        rsp->fog_mul=item.fogMul;rsp->fog_offset=item.fogOffset;
+        rsp->lights_changed=true;
+        probe.mSceneVertexBatch=item.batch;
+        std::memcpy(source,item.vertices,item.count*sizeof(F3DVtx));
+    };
+    auto reference=makeProbe(),candidate=makeProbe();
+    auto referenceSources=std::make_unique<std::vector<SourceBuffer>>(512);
+    auto candidateSources=std::make_unique<std::vector<SourceBuffer>>(512);
+    uint32_t previousPose=UINT32_MAX;
+    bool exact=true;
+    for(const auto& item:records){
+        if(item.pose!=previousPose){
+            for(auto& ways:reference->mPreparedLighting)for(auto& entry:ways)entry.vertices=nullptr;
+            previousPose=item.pose;
+        }
+        auto* refSource=(*referenceSources)[item.batch].data();
+        auto* newSource=(*candidateSources)[item.batch].data();
+        prepare(*reference,item,refSource);
+        prepare(*candidate,item,newSource);
+        mmvr::SetLightingBenchVariant(mmvr::LightingBenchVariant::PriorOneWay,int(item.pose));
+        reference->GfxSpVertexImpl(item.count,item.dest,refSource,true);
+        mmvr::SetLightingBenchVariant(mmvr::LightingBenchVariant::RetainedThreeWay,int(item.pose));
+        candidate->GfxSpVertexImpl(item.count,item.dest,newSource,true);
+        for(size_t i=item.dest;i<item.dest+item.count;++i)
+            exact&=std::memcmp(&reference->mRsp->loaded_vertices[i],&candidate->mRsp->loaded_vertices[i],
+                               offsetof(LoadedVertex,clip_rej)+sizeof(LoadedVertex::clip_rej))==0;
+    }
+    mmvr::SetLightingBenchVariant(mmvr::LightingBenchVariant::Off,0);
+    if(!exact)throw std::runtime_error("Real lighting workload changed loaded vertices");
+    // Allocate and touch the same per-batch buffers before measuring. Each
+    // measured stream is a new native tick: retained entries expire once at
+    // its start, while the original one-way entries expire for every pose.
+    constexpr unsigned measuredTicks=3;
+    struct Trial{const char* variant;int64_t nanos;uint64_t hits,misses;};
+    std::array<Trial,12> trials{};
+    for(size_t trial=0;trial<trials.size();++trial){
+        const bool prior=trial%4==0||trial%4==3;
+        auto probe=makeProbe();
+        auto sources=std::make_unique<std::vector<SourceBuffer>>(512);
+        auto runTick=[&](){
+            for(auto& ways:probe->mPreparedLighting)for(auto& entry:ways)entry.vertices=nullptr;
+            uint32_t pose=UINT32_MAX;
+            for(const auto& item:records){
+                if(prior&&item.pose!=pose)
+                    for(auto& ways:probe->mPreparedLighting)for(auto& entry:ways)entry.vertices=nullptr;
+                pose=item.pose;
+                auto* source=(*sources)[item.batch].data();
+                prepare(*probe,item,source);
+                mmvr::SetLightingBenchVariant(prior?mmvr::LightingBenchVariant::PriorOneWay:
+                    mmvr::LightingBenchVariant::RetainedThreeWay,int(item.pose));
+                probe->GfxSpVertexImpl(item.count,item.dest,source,true);
+            }
+        };
+        runTick();
+        probe->mPreparedLightingHits=0;
+        probe->mPreparedLightingMisses=0;
+        const auto start=std::chrono::steady_clock::now();
+        for(unsigned tick=0;tick<measuredTicks;++tick)runTick();
+        const auto elapsed=std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now()-start).count();
+        trials[trial]={prior?"prior":"retained",elapsed/measuredTicks,
+            probe->mPreparedLightingHits,probe->mPreparedLightingMisses};
+        mmvr::SetLightingBenchVariant(mmvr::LightingBenchVariant::Off,0);
+    }
+    std::ofstream output("native-lighting-workload-probe.json");
+    output<<"{\"exact\":true,\"records\":"<<records.size()<<",\"poses\":[";
+    for(size_t i=0;i<poseCounts.size();++i){if(i)output<<',';output<<poseCounts[i];}
+    output<<"],\"baseline\":\"original one-way per replay\",\"measure\":\"warmed CPU vertex replay per native tick, no GPU or XR\",\"warmupTicks\":1,\"measuredTicks\":"<<measuredTicks<<",\"trials\":[";
+    for(size_t i=0;i<trials.size();++i){if(i)output<<',';const auto& t=trials[i];
+        output<<"{\"variant\":\""<<t.variant<<"\",\"ns\":"<<t.nanos
+              <<",\"hits\":"<<t.hits<<",\"misses\":"<<t.misses<<'}';}
+    output<<"]}";
+}
diff -ruN a/libultraship/src/fast/interpreter_native_bounds_test.inc b/libultraship/src/fast/interpreter_native_bounds_test.inc
--- a/libultraship/src/fast/interpreter_native_bounds_test.inc	1970-01-01 00:00:00.000000000 +0000
+++ b/libultraship/src/fast/interpreter_native_bounds_test.inc	2026-10-23 06:54:56.119804092 +0000
@@ -0,0 +1,221 @@
+// CPU-only native command/stack check, independent of the live renderer state.
+void Interpreter::VerifyNativeBoundsCulling() {
+    const char* diagnostic = std::getenv("MMVR_NATIVE_TEST");
+    if (!diagnostic || std::strcmp(diagnostic, "1") != 0) return;
+    struct Restore {
+        GfxExecStack stack = std::move(g_exec_stack);
+        mmvr::CullingAudit audit = mmvr::cullingAudit;
+        ~Restore() { g_exec_stack = std::move(stack); mmvr::cullingAudit = audit; }
+    } restore;
+    Interpreter probe;
+    CommandInterpreterScope scope(&probe);
+    F3DGfx parent[2]{}, child[2]{};
+    unsigned checks = 0;
+    auto check = [&](bool ok) { ++checks; if (!ok) throw std::runtime_error("Native bounds command regression"); };
+    auto bounds = [&](unsigned first, unsigned last) {
+        child[0].words.w0 = (uintptr_t(F3DEX2_G_CULLDL) << 24) | first;
+        child[0].words.w1 = last;
+    };
+    auto begin = [&]() {
+        g_exec_stack.start(parent + 1);
+        g_exec_stack.call(parent, child);
+        probe.mMarkerOn = true;
+    };
+    bounds(0, 14);
+    for (unsigned plane : {1u, 2u, 4u, 8u, 32u}) {
+        for (auto& v : probe.mRsp->loaded_vertices) v.clip_rej = plane;
+        begin();
+        auto& command = g_exec_stack.currCmd();
+        check(gfx_cull_native_bounds(&command, false));
+        // Do not read command after returning: it was a reference to the popped entry.
+        check(g_exec_stack.cmd_stack.size() == 1 && g_exec_stack.currCmd() == parent + 1);
+        check(g_exec_stack.gfx_path.empty() && !probe.mMarkerOn);
+        for (int visible = 0; visible < 8; ++visible) {
+            probe.mRsp->loaded_vertices[visible].clip_rej = 0;
+            begin(); auto* before = g_exec_stack.currCmd();
+            check(!gfx_cull_native_bounds(&g_exec_stack.currCmd(), false));
+            check(g_exec_stack.cmd_stack.size() == 2 && g_exec_stack.currCmd() == before && probe.mMarkerOn);
+            probe.mRsp->loaded_vertices[visible].clip_rej = plane;
+        }
+    }
+    for (auto& v : probe.mRsp->loaded_vertices) v.clip_rej = 16;
+    begin(); check(!gfx_cull_native_bounds(&g_exec_stack.currCmd(), false)); // Near plane stays conservative.
+    for (auto& v : probe.mRsp->loaded_vertices) v.clip_rej = 1;
+    for (auto range : {std::pair{1u,14u}, {0u,15u}, {14u,0u}, {0u,65534u}}) {
+        bounds(range.first,range.second);begin();
+        check(!gfx_cull_native_bounds(&g_exec_stack.currCmd(), false));
+        check(g_exec_stack.cmd_stack.size() == 2);
+    }
+    bounds(0,14);begin();
+    g_exec_stack.branch(child);g_exec_stack.branch(child);
+    check(g_exec_stack.cmd_stack.size() == 4);
+    check(gfx_cull_native_bounds(&g_exec_stack.currCmd(), false));
+    check(g_exec_stack.cmd_stack.size() == 1 && g_exec_stack.currCmd() == parent+1 && g_exec_stack.gfx_path.empty());
+    g_exec_stack.start(child);probe.mMarkerOn = true;
+    check(gfx_cull_native_bounds(&g_exec_stack.currCmd(), false));
+    check(g_exec_stack.cmd_stack.empty() && !probe.mMarkerOn);
+    begin();auto oldCandidates = mmvr::cullingAudit.candidates;mmvr::cullingAudit.NewReplay();
+    check(!gfx_cull_native_bounds(&g_exec_stack.currCmd(), true));
+    check(g_exec_stack.cmd_stack.size() == 2 && probe.mMarkerOn && mmvr::cullingAudit.candidates == oldCandidates+1);
+    // The ordinary end handler must leave the same parent pointer/path/marker.
+    check(gfx_end_dl_handler_common(&g_exec_stack.currCmd()));
+    check(g_exec_stack.cmd_stack.size() == 1 && g_exec_stack.currCmd() == parent+1 && !probe.mMarkerOn);
+    // Paired native-list return: either visible eye or either safety margin
+    // retains the shared list. Exercise the actual return/branch-stack helper.
+    const auto pairedGuard=mmvr::MakeCullingGuard({-.8f,.8f,.8f,-.8f},20);
+    mmvr::CullingGuard pairedGuards[2]{pairedGuard,pairedGuard};
+    auto resetBounds=[&]() {
+        bounds(0,14);
+        for(unsigned i=0;i<8;++i) {
+            for(auto* vertex:{&probe.mRsp->loaded_vertices[i],&probe.mStereoRsp.loaded_vertices[i]}) {
+                vertex->x=10;vertex->y=0;vertex->z=0;vertex->w=1;vertex->clip_rej=2;
+            }
+        }
+        begin();
+    };
+    resetBounds();
+    check(gfx_cull_native_bounds_checked(&g_exec_stack.currCmd(),false,pairedGuards));
+    check(g_exec_stack.cmd_stack.size()==1 && g_exec_stack.currCmd()==parent+1 && !probe.mMarkerOn);
+    for(bool right:{false,true}) {
+        resetBounds();
+        auto& vertex=right?probe.mStereoRsp.loaded_vertices[0]:probe.mRsp->loaded_vertices[0];
+        vertex.x=0;vertex.clip_rej=0;
+        check(!gfx_cull_native_bounds_checked(&g_exec_stack.currCmd(),false,pairedGuards));
+        check(g_exec_stack.cmd_stack.size()==2 && probe.mMarkerOn);
+        // Outside the actual eye but inside its padded field remains visible.
+        vertex.x=1.01f;vertex.clip_rej=2;
+        check(!gfx_cull_native_bounds_checked(&g_exec_stack.currCmd(),false,pairedGuards));
+    }
+    resetBounds();pairedGuards[1].active=false;
+    check(!gfx_cull_native_bounds_checked(&g_exec_stack.currCmd(),false,pairedGuards));
+    pairedGuards[1]=pairedGuard;
+    resetBounds();
+    for(unsigned i=0;i<8;++i){probe.mStereoRsp.loaded_vertices[i].x=-10;probe.mStereoRsp.loaded_vertices[i].clip_rej=1;}
+    g_exec_stack.branch(child);g_exec_stack.branch(child);
+    check(gfx_cull_native_bounds_checked(&g_exec_stack.currCmd(),false,pairedGuards));
+    check(g_exec_stack.cmd_stack.size()==1 && g_exec_stack.currCmd()==parent+1);
+    resetBounds();
+    check(!gfx_cull_native_bounds_checked(&g_exec_stack.currCmd(),true,pairedGuards));
+    check(g_exec_stack.cmd_stack.size()==2 && probe.mMarkerOn);
+    // Real interpreter cache lifetime and immediate reappearance, using native
+    // vertex slots and encoded TRI2 commands. No live tracking state is changed.
+    F3DGfx packets[65]{};
+    for(unsigned i=0;i<64;++i){packets[i].words.w0=0x06000204;packets[i].words.w1=0x00020406;}
+    packets[64].words.w0=uintptr_t(F3DEX2_G_ENDDL)<<24;
+    const auto guard=mmvr::MakeCullingGuard({-.8f,.8f,.8f,-.8f},20);
+    probe.SetResolvedResourceCacheEnabled(true);
+    for(auto& v:probe.mRsp->loaded_vertices){v.x=10;v.y=0;v.w=1;v.clip_rej=2;}
+    auto* cursor=packets;
+    check(probe.CullTrianglePacketGuarded(cursor,guard) && cursor==packets+64);
+    const auto loaded=probe.mRsp->loaded_vertices[0];
+    probe.mRsp->loaded_vertices[0].x=0;cursor=packets;
+    check(!probe.CullTrianglePacketGuarded(cursor,guard) && cursor==packets);
+    probe.mRsp->loaded_vertices[0]=loaded;
+    probe.SetResolvedResourceCacheEnabled(false);check(probe.mTrianglePackets.empty());
+    // Same address, different next tick: no stale skip through a state opcode.
+    packets[3].words.w0=uintptr_t(F3DEX2_G_MTX)<<24;
+    probe.SetResolvedResourceCacheEnabled(true);cursor=packets;
+    check(probe.CullTrianglePacketGuarded(cursor,guard) && cursor==packets+3);
+    cursor=packets;check(!probe.CullTrianglePacketGuarded(cursor,{}) && cursor==packets);
+    std::ofstream benchmark("native-packet-culling.json");benchmark<<"{\"passed\":true,\"workloads\":[";
+    bool first=true;
+    for(unsigned length:{3u,8u,32u,64u}){
+        for(unsigned i=0;i<64;++i)packets[i].words.w0=0x06000204;
+        packets[length].words.w0=uintptr_t(F3DEX2_G_ENDDL)<<24;
+        probe.SetResolvedResourceCacheEnabled(false);probe.SetResolvedResourceCacheEnabled(true);
+        cursor=packets;check(probe.CullTrianglePacketGuarded(cursor,guard));
+        std::vector<double> before,after;
+        for(int round=0;round<7;++round)for(int pass=0;pass<2;++pass){
+            const bool candidate=(round+pass)%2;
+            auto start=std::chrono::steady_clock::now();
+            for(int repeat=0;repeat<2000;++repeat){
+                probe.BeginTriangleCommand(true);
+                cursor=packets;
+                if(!candidate || !probe.CullTrianglePacketGuarded(cursor,guard))
+                    for(unsigned i=0;i<length;++i)probe.GfxSpTri2(0,1,2,1,2,3);
+                probe.BeginTriangleCommand(false);
+            }
+            auto ms=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();
+            (candidate?after:before).push_back(ms);
+        }
+        std::sort(before.begin(),before.end());std::sort(after.begin(),after.end());
+        if(!first)benchmark<<",";first=false;
+        benchmark<<"{\"commands\":"<<length<<",\"packets\":2000,\"referenceMs\":"<<before[3]<<",\"candidateMs\":"<<after[3]<<"}";
+    }
+    benchmark<<"],\"wholeGameFps\":false}";
+    probe.SetResolvedResourceCacheEnabled(false);
+
+    // Early archive-run rejection reconstructs every final vertex slot. Verify
+    // real lighting/UV/fog/clip values, including partial overwritten ranges.
+    F3DVtx raw[3][4]{};
+    F3DGfx early[13]{};
+    for(unsigned group=0;group<3;++group) {
+        for(unsigned v=0;v<4;++v) {
+            raw[group][v].v.ob[0]=int16_t(20+group+v);
+            raw[group][v].v.ob[1]=int16_t(v);
+            raw[group][v].v.cn[0]=uint8_t(group*30+v);
+            raw[group][v].v.cn[3]=255;
+            raw[group][v].v.tc[0]=int16_t(group*32+v);
+        }
+        early[group*4].words.w0=0x01000000;
+        early[group*4].words.w1=reinterpret_cast<uintptr_t>(raw[group]);
+        for(unsigned t=1;t<4;++t){early[group*4+t].words.w0=0x06000204;early[group*4+t].words.w1=0x00020400;}
+    }
+    early[12].words.w0=uintptr_t(F3DEX2_G_ENDDL)<<24;
+    struct FixtureResolver {
+        bool operator()(const F3DGfx* c,mmvr::GeometryLoad& load) const {
+            if((c->words.w0>>24)!=1)return false;
+            load={reinterpret_cast<const void*>(c->words.w1),uint16_t((c->words.w0&255)?3:4),0,1};return true;
+        }
+        static std::array<float,3> Position(const mmvr::GeometryLoad& load,unsigned i) {
+            return ArchiveGeometryResolver::Position(load,i);
+        }
+    } resolver;
+    early[8].words.w0|=1;
+    const auto run=mmvr::CompileGeometryRun(early,resolver);
+    check(run.commands==12 && run.retainedVertices==7);
+    for(uint32_t mode:{0u,uint32_t(G_LIGHTING),uint32_t(G_LIGHTING|G_FOG|G_TEXTURE_GEN)}) {
+        Interpreter reference, candidate;
+        for(auto* state:{&reference,&candidate}) {
+            state->mCurDimensions.width=320;state->mCurDimensions.height=240;
+            state->mRsp->geometry_mode=mode;
+            state->mRsp->current_num_lights=1;
+            state->mRsp->modelview_matrix_stack_size=1;
+            for(unsigned a=0;a<4;++a){state->mRsp->MP_matrix[a][a]=1;state->mRsp->modelview_matrix_stack[0][a][a]=1;}
+            state->mRsp->current_lights[0].l.col[0]=100;
+            state->mRsp->current_lights[0].l.col[1]=120;
+            state->mRsp->current_lights[0].l.col[2]=140;
+            state->mRsp->lights_changed=true;
+        }
+        for(unsigned group=0;group<3;++group)reference.GfxSpVertex(group==2?3:4,0,raw[group]);
+        auto* current=early;
+        check(candidate.CullGeometryRunGuarded(current,run,guard) && current==early+12);
+        check(std::memcmp(reference.mRsp->loaded_vertices,candidate.mRsp->loaded_vertices,sizeof(reference.mRsp->loaded_vertices))==0);
+        check(reference.mRsp->lights_changed==candidate.mRsp->lights_changed);
+        // Exercise the paired rejection gate and verify its retained writes in
+        // the primary RSP. Live paired replay verifies the secondary RSP.
+        Interpreter paired;
+        paired.mCurDimensions.width=320;paired.mCurDimensions.height=240;
+        paired.mRsp->geometry_mode=mode;paired.mRsp->current_num_lights=1;
+        paired.mRsp->modelview_matrix_stack_size=1;
+        for(unsigned a=0;a<4;++a){paired.mRsp->MP_matrix[a][a]=1;paired.mRsp->modelview_matrix_stack[0][a][a]=1;paired.mStereoRsp.MP_matrix[a][a]=1;}
+        paired.mRsp->current_lights[0].l.col[0]=100;
+        paired.mRsp->current_lights[0].l.col[1]=120;
+        paired.mRsp->current_lights[0].l.col[2]=140;
+        paired.mRsp->lights_changed=true;
+        current=early;
+        check(paired.CullGeometryRunGuarded(current,run,guard,paired.mStereoRsp.MP_matrix,guard) && current==early+12);
+        check(std::memcmp(reference.mRsp->loaded_vertices,paired.mRsp->loaded_vertices,sizeof(reference.mRsp->loaded_vertices))==0);
+        check(reference.mRsp->lights_changed==paired.mRsp->lights_changed);
+        paired.mStereoRsp.MP_matrix[3][0]=-22;current=early;
+        check(!paired.CullGeometryRunGuarded(current,run,guard,paired.mStereoRsp.MP_matrix,guard) && current==early);
+        paired.mStereoRsp.MP_matrix[3][0]=0;current=early;
+        check(!paired.CullGeometryRunGuarded(current,run,guard,paired.mStereoRsp.MP_matrix,{}) && current==early);
+        candidate.mRsp->MP_matrix[3][0]=-22;current=early;
+        check(!candidate.CullGeometryRunGuarded(current,run,guard) && current==early);
+    }
+    const char* token=std::getenv("MMVR_SESSION_TOKEN");
+    std::ofstream("native-native-bounds.json") << "{\"session\":\"" << (token?token:"")
+        << "\",\"passed\":true,\"checks\":" << checks
+        << ",\"nativeCallAndBranchReturns\":true,\"observedOnlyPreservesStack\":true}";
+}
diff -ruN a/libultraship/src/fast/interpreter_readback_test.inc b/libultraship/src/fast/interpreter_readback_test.inc
--- a/libultraship/src/fast/interpreter_readback_test.inc	1970-01-01 00:00:00.000000000 +0000
+++ b/libultraship/src/fast/interpreter_readback_test.inc	2026-10-23 06:54:56.119816302 +0000
@@ -0,0 +1,89 @@
+// Exercise the real G_READFB dispatcher with a CPU-only renderer. This keeps
+// the native pictograph result stable across the later eye/HUD replay while
+// preserving legacy effect readbacks and two-word command consumption.
+void Interpreter::VerifyNativeReadbackCapture() {
+    const char* enabled = std::getenv("MMVR_NATIVE_TEST");
+    if (!enabled || std::strcmp(enabled, "1") != 0) return;
+    if (mmvr::IsExtraPass())
+        throw std::runtime_error("Native readback fixture must start outside an eye replay");
+
+    struct Restore {
+        GfxExecStack stack = std::move(g_exec_stack);
+        decltype(ucode_handler_index) ucode = ucode_handler_index;
+        bool tracking = mmvr::nativeTestTracking;
+        ~Restore() {
+            g_exec_stack = std::move(stack);
+            ucode_handler_index = ucode;
+            mmvr::SetNativeTestTracking(false);
+            if (tracking) mmvr::SetNativeTestTracking(true);
+        }
+    } restore;
+
+    TriangleProbeRenderer backend;
+    backend.readbackEnabled = true;
+    Interpreter probe;
+    probe.mRapi = &backend;
+    CommandInterpreterScope commandScope(&probe);
+    ucode_handler_index = ucode_f3dex2;
+
+    unsigned checks = 0;
+    auto check = [&](bool condition) {
+        ++checks;
+        if (!condition) throw std::runtime_error("G_READFB native capture regression");
+    };
+    auto stepReadback = [&](std::array<uint16_t, 4>& pixels, bool nativeOnly, bool byteswap) {
+        F3DGfx commands[2]{};
+        constexpr unsigned framebuffer = 7;
+        commands[0].words.w0 = (uintptr_t(OTR_G_READFB) << 24) | framebuffer |
+                               (byteswap ? uintptr_t(1u << 8) : 0) |
+                               (nativeOnly ? uintptr_t(1u << 9) : 0);
+        commands[0].words.w1 = reinterpret_cast<uintptr_t>(pixels.data());
+        commands[1].words.w0 = (uint32_t(9) << 16) | uint32_t(5);
+        commands[1].words.w1 = (uint32_t(2) << 16) | uint32_t(2);
+        g_exec_stack.start(commands);
+        gfx_step();
+        return g_exec_stack.currCmd() == commands + 2;
+    };
+    auto expected = [](uint16_t color, bool byteswap) {
+#if !defined(IS_BIGENDIAN)
+        if (byteswap) return uint16_t((color << 8) | (color >> 8));
+#endif
+        return color;
+    };
+
+    mmvr::SetNativeTestTracking(true);
+    std::array<uint16_t, 4> photo{};
+    backend.readbackColor = 0x1234;
+    const bool nativeConsumed = stepReadback(photo, true, true);
+    check(backend.readbackCalls == 1 && backend.lastReadbackFramebuffer == 7 &&
+          backend.lastReadbackWidth == 2 && backend.lastReadbackHeight == 2 &&
+          std::all_of(photo.begin(), photo.end(), [&](uint16_t value) { return value == expected(0x1234, true); }));
+    check(nativeConsumed);
+
+    const auto capturedPhoto = photo;
+    const auto beforeSkipped = backend.readbackCalls;
+    backend.readbackColor = 0x0000;
+    mmvr::SetNativeTestEye(0.0f);
+    const bool skippedConsumed = stepReadback(photo, true, true);
+    check(skippedConsumed && backend.readbackCalls == beforeSkipped && photo == capturedPhoto);
+
+    // The native-only bit must not suppress ordinary native effects such as
+    // the Deku-bubble path, even when its extra eye readback is byte-swapped.
+    backend.readbackColor = 0x5A2B;
+    const bool bubbleConsumed = stepReadback(photo, false, true);
+    check(bubbleConsumed && backend.readbackCalls == beforeSkipped + 1 &&
+          std::all_of(photo.begin(), photo.end(), [&](uint16_t value) { return value == expected(0x5A2B, true); }));
+
+    mmvr::SetNativeTestTracking(false);
+    mmvr::SetNativeTestTracking(true);
+    backend.readbackColor = 0x6C91;
+    const bool nextNativeConsumed = stepReadback(photo, true, true);
+    check(nextNativeConsumed && backend.readbackCalls == beforeSkipped + 2 &&
+          std::all_of(photo.begin(), photo.end(), [&](uint16_t value) { return value == expected(0x6C91, true); }));
+
+    const char* session = std::getenv("MMVR_SESSION_TOKEN");
+    std::ofstream("native-readback-capture.json") << "{\"session\":\"" << (session ? session : "")
+        << "\",\"passed\":true,\"checks\":" << checks
+        << ",\"nativeColorRetainedAcrossEyeReplay\":true,\"legacyReadbackStillRuns\":true"
+        << ",\"newNativeCaptureRefreshesBuffer\":true,\"twoWordCommandsConsumed\":true}";
+}
diff -ruN a/libultraship/src/fast/interpreter_retained_resources_test.inc b/libultraship/src/fast/interpreter_retained_resources_test.inc
--- a/libultraship/src/fast/interpreter_retained_resources_test.inc	1970-01-01 00:00:00.000000000 +0000
+++ b/libultraship/src/fast/interpreter_retained_resources_test.inc	2026-10-23 06:54:56.119825727 +0000
@@ -0,0 +1,104 @@
+// Included inside namespace Fast. Exercises cross-tick resource retention with
+// the live resource manager and an isolated interpreter, restoring every
+// manager change it makes. Writes native-retained-resources.json.
+void Interpreter::VerifyRetainedResources(const char* signaturePath, uint64_t hash) {
+    const char* test = std::getenv("MMVR_NATIVE_TEST");
+    if (!test || std::strcmp(test, "1") != 0 || !signaturePath) return;
+    if (!RetainedResourcesEnabled()) {
+        std::ofstream("native-retained-resources.json") << "{\"reference\":true}";
+        return;
+    }
+    const auto manager = Ship::Context::GetRawInstance()->GetResourceManager();
+    std::string_view base = signaturePath;
+    if (base.starts_with("__OTR__")) base.remove_prefix(7);
+    const std::string basePath(base);
+    Interpreter probe;
+    unsigned checks = 0;
+    auto check = [&](bool ok, const char* what) {
+        ++checks;
+        if (!ok) throw std::runtime_error(std::string("Retained resource regression: ") + what);
+    };
+    auto tick = [&](auto&& body) {
+        probe.SetResolvedResourceCacheEnabled(true);
+        body();
+        probe.SetResolvedResourceCacheEnabled(false);
+    };
+
+    // 1. A later tick reuses the resolution by content, from a different pointer.
+    std::shared_ptr<Ship::IResource> first;
+    void* firstRaw = nullptr;
+    tick([&] {
+        first = probe.ResolveResourceCached(signaturePath);
+        firstRaw = probe.ResolveResourceRawCached(hash);
+    });
+    check(first && firstRaw == first->GetRawPointer(), "initial resolution");
+    const std::string copy(signaturePath);
+    auto hits = probe.mRetainedResourceDiagnostics.hits;
+    tick([&] {
+        check(probe.ResolveResourceCached(copy.c_str()) == first, "path reuse");
+        check(probe.ResolveResourceRawCached(hash) == firstRaw, "hash reuse");
+    });
+    check(probe.mRetainedResourceDiagnostics.hits >= hits + 2, "reuse was not retained");
+
+    // 2. A reused pointer holding different text must not return the old resource.
+    std::array<char, 256> buffer{};
+    check(copy.size() < buffer.size(), "fixture path length");
+    std::memcpy(buffer.data(), copy.c_str(), copy.size() + 1);
+    tick([&] { check(probe.ResolveResourceCached(buffer.data()) == first, "buffer resolution"); });
+    constexpr std::string_view missing = "__mmvr_missing_retained_resource_probe__";
+    std::memcpy(buffer.data(), missing.data(), missing.size());
+    buffer[missing.size()] = 0;
+    tick([&] { check(probe.ResolveResourceCached(buffer.data()) == nullptr, "pointer reuse with new text"); });
+
+    // 3. Replacements are observed between ticks and within a tick. With
+    // alternate assets on, an alt override would win over the base key, so the
+    // base-key replacement is only meaningful (and safely restorable) when off.
+    const bool alt = manager->IsAltAssetsEnabled();
+    if (!alt) {
+        // A separately owned load of the same file is a distinct, valid object.
+        auto replacement = manager->LoadResource(Ship::ResourceIdentifier{ basePath, 0x4d565252, nullptr });
+        check(replacement && replacement != first, "distinct replacement");
+        const auto generation = manager->GetResolutionGeneration();
+        manager->CacheExternalResource(basePath, replacement);
+        check(manager->GetResolutionGeneration() != generation, "replacement advanced generation");
+        tick([&] {
+            check(probe.ResolveResourceCached(copy.c_str()) == replacement, "replacement path");
+            check(probe.ResolveResourceRawCached(hash) == replacement->GetRawPointer(), "replacement hash");
+        });
+        // Mid-tick: the path is already owned by this tick, the hash is not yet.
+        tick([&] {
+            check(probe.ResolveResourceCached(copy.c_str()) == replacement, "retained replacement");
+            manager->CacheExternalResource(basePath, first);
+            check(probe.ResolveResourceRawCached(hash) == first->GetRawPointer(), "mid-tick restore observed");
+        });
+        tick([&] { check(probe.ResolveResourceCached(copy.c_str()) == first, "original restored"); });
+    }
+
+    // 4. Alternate-asset mode changes discard every retained answer.
+    auto clears = probe.mRetainedResourceDiagnostics.clears;
+    manager->SetAltAssetsEnabled(!alt);
+    tick([&] {});
+    manager->SetAltAssetsEnabled(alt);
+    check(probe.mRetainedResourceDiagnostics.clears > clears, "alt toggle clear");
+
+    // 5. Texture-cache invalidation does not change how resources resolve.
+    tick([&] { check(probe.ResolveResourceCached(copy.c_str()) == first, "before texture clear"); });
+    probe.TextureCacheClear();
+    tick([&] { check(probe.ResolveResourceCached(copy.c_str()) == first, "after texture clear"); });
+
+    // 6. Per-tick maps still release at every tick end; ClearRetainedResources
+    // (called by Destroy) releases the rest.
+    tick([&] { probe.ResolveResourceRawCached(hash); });
+    check(probe.mResolvedResourceCache.empty() && probe.mResolvedHashPaths.empty() && probe.mResolvedRawHashes.empty(),
+          "per-tick release");
+    probe.ClearRetainedResources();
+    check(probe.mRetainedHashPaths.empty() && probe.mRetainedHashResources.empty() &&
+              probe.mRetainedPathResources.empty() && !probe.mRetainedResourcesValid,
+          "explicit release");
+
+    std::ofstream("native-retained-resources.json")
+        << "{\"passed\":true,\"checks\":" << checks << ",\"altAssets\":" << alt
+        << ",\"hits\":" << probe.mRetainedResourceDiagnostics.hits
+        << ",\"misses\":" << probe.mRetainedResourceDiagnostics.misses
+        << ",\"clears\":" << probe.mRetainedResourceDiagnostics.clears << "}";
+}
diff -ruN a/libultraship/src/fast/interpreter_shared_lighting_test.inc b/libultraship/src/fast/interpreter_shared_lighting_test.inc
--- a/libultraship/src/fast/interpreter_shared_lighting_test.inc	1970-01-01 00:00:00.000000000 +0000
+++ b/libultraship/src/fast/interpreter_shared_lighting_test.inc	2026-10-23 06:54:56.119923619 +0000
@@ -0,0 +1,201 @@
+// CPU-only differential fixture. It never touches the live interpreter or GPU.
+void Interpreter::VerifySharedLightingTickCache() {
+    const char* diagnostic=std::getenv("MMVR_NATIVE_TEST");
+    if(!diagnostic||std::strcmp(diagnostic,"1")!=0)return;
+    Interpreter reference,candidate;
+    reference.mSharedScenePreparation=false;
+    candidate.mSharedScenePreparation=true;
+    candidate.mTextureCacheDiagnosticsEnabled=true;
+    reference.mFbActive=candidate.mFbActive=true;
+    reference.mActiveFrameBuffer=reference.mFrameBuffers.end();
+    candidate.mActiveFrameBuffer=candidate.mFrameBuffers.end();
+    reference.mCurDimensions.width=candidate.mCurDimensions.width=320;
+    reference.mCurDimensions.height=candidate.mCurDimensions.height=240;
+    constexpr size_t count=32;
+    std::array<F3DVtx,count> source{};
+    for(size_t i=0;i<count;++i){
+        source[i].v.ob[0]=short(int(i)*3-45);
+        source[i].v.ob[1]=short(int(i)*5-65);
+        source[i].v.ob[2]=short(int(i)*7+12);
+        source[i].v.tc[0]=short(int(i)*41);
+        source[i].v.tc[1]=short(int(i)*-27);
+        source[i].n.n[0]=int8_t((int(i)%5)*18-36);
+        source[i].n.n[1]=int8_t((int(i)%7)*13-39);
+        source[i].n.n[2]=80;
+    }
+    auto configure=[&](Interpreter& probe,int eye,uint32_t mode){
+        auto* rsp=probe.mRsp;
+        rsp->geometry_mode=mode;
+        rsp->modelview_matrix_stack_size=1;
+        rsp->current_num_lights=2;
+        rsp->texture_scaling_factor.s=0xffff;
+        rsp->texture_scaling_factor.t=0xffff;
+        rsp->lights_changed=true;
+        std::memset(rsp->modelview_matrix_stack[0],0,sizeof(rsp->modelview_matrix_stack[0]));
+        std::memset(rsp->MP_matrix,0,sizeof(rsp->MP_matrix));
+        for(int axis=0;axis<4;++axis){
+            rsp->modelview_matrix_stack[0][axis][axis]=1.f;
+            rsp->MP_matrix[axis][axis]=1.f;
+        }
+        const float angle=float(eye-1)*.035f;
+        rsp->modelview_matrix_stack[0][0][0]=std::cos(angle);
+        rsp->modelview_matrix_stack[0][0][2]=std::sin(angle);
+        rsp->modelview_matrix_stack[0][2][0]=-std::sin(angle);
+        rsp->modelview_matrix_stack[0][2][2]=std::cos(angle);
+        rsp->current_lights[0].l.col[0]=180;
+        rsp->current_lights[0].l.col[1]=150;
+        rsp->current_lights[0].l.col[2]=110;
+        if(mode&G_LIGHTING_POSITIONAL){
+            rsp->current_lights[0].p.unk3=1;
+            rsp->current_lights[0].p.pos[0]=80;
+            rsp->current_lights[0].p.pos[1]=12;
+            rsp->current_lights[0].p.pos[2]=-20;
+        }else{
+            rsp->current_lights[0].p.unk3=0;
+            rsp->current_lights[0].l.dir[0]=40;
+            rsp->current_lights[0].l.dir[1]=30;
+            rsp->current_lights[0].l.dir[2]=115;
+        }
+        rsp->current_lights[1].l.col[0]=40;
+        rsp->current_lights[1].l.col[1]=35;
+        rsp->current_lights[1].l.col[2]=30;
+        rsp->lookat[0].dir[0]=127;rsp->lookat[0].dir[1]=0;rsp->lookat[0].dir[2]=0;
+        rsp->lookat[1].dir[0]=0;rsp->lookat[1].dir[1]=127;rsp->lookat[1].dir[2]=0;
+    };
+    bool exact=true;
+    auto compare=[&](int eye,uint32_t mode,int mutation=0,size_t batch=0){
+        configure(reference,eye,mode);configure(candidate,eye,mode);
+        for(auto* probe:{&reference,&candidate}){
+            if(mutation==1)probe->mRsp->current_lights[0].l.col[0]++;
+            if(mutation==2)probe->mRsp->lookat[0].dir[0]--;
+            if(mutation==3)probe->mRsp->modelview_matrix_stack[0][3][0]+=2.f;
+            if(mutation==4)probe->mRsp->current_lights[2].l.col[0]++;
+            if(mutation==5)probe->mRsp->lookat[0].dir[0]--;
+        }
+        reference.mSceneVertexBatch=0;candidate.mSceneVertexBatch=batch;
+        reference.GfxSpVertexImpl(count,0,source.data(),true);
+        candidate.GfxSpVertexImpl(count,0,source.data(),true);
+        for(size_t i=0;i<count;++i)
+            exact &= std::memcmp(&reference.mRsp->loaded_vertices[i],&candidate.mRsp->loaded_vertices[i],
+                                 offsetof(LoadedVertex,clip_rej)+sizeof(LoadedVertex::clip_rej))==0;
+    };
+    for(int pass=0;pass<3;++pass)for(int eye=0;eye<3;++eye)compare(eye,G_LIGHTING);
+    const bool reused=candidate.mPreparedLightingHits>=6;
+    const auto beforeMutation=candidate.mPreparedLightingMisses;
+    source[0].n.n[0]++;
+    compare(0,G_LIGHTING);
+    const bool sourceInvalidated=candidate.mPreparedLightingMisses>beforeMutation;
+    source[1].v.ob[0]++;
+    source[2].v.tc[0]++;
+    compare(0,G_LIGHTING);
+    auto clear=[&](){
+        for(auto& ways:candidate.mPreparedLighting)for(auto& entry:ways)entry.vertices=nullptr;
+        candidate.InvalidateAddressLightingCache();
+    };
+    clear();compare(0,G_LIGHTING);
+    const auto beforeActiveLight=candidate.mPreparedLightingMisses;
+    compare(0,G_LIGHTING,1);
+    const bool activeLightInvalidated=candidate.mPreparedLightingMisses>beforeActiveLight;
+    clear();compare(0,G_LIGHTING|G_TEXTURE_GEN);
+    const auto beforeTexgenLookat=candidate.mPreparedLightingMisses;
+    compare(0,G_LIGHTING|G_TEXTURE_GEN,2);
+    const bool texgenLookatInvalidated=candidate.mPreparedLightingMisses>beforeTexgenLookat;
+    clear();compare(0,G_LIGHTING);
+    const auto beforeIrrelevant=candidate.mPreparedLightingHits;
+    compare(0,G_LIGHTING,4); // light 2 is outside the active [0,2) prefix
+    compare(0,G_LIGHTING,5); // lookat is unused without texture generation
+    compare(0,G_LIGHTING,3); // directional lights ignore model translation
+    const bool irrelevantReused=candidate.mPreparedLightingHits>=beforeIrrelevant+3;
+    clear();compare(0,G_LIGHTING|G_LIGHTING_POSITIONAL);
+    const auto beforePosition=candidate.mPreparedLightingMisses;
+    compare(0,G_LIGHTING|G_LIGHTING_POSITIONAL,3);
+    const bool positionInvalidated=candidate.mPreparedLightingMisses>beforePosition;
+    compare(1,G_LIGHTING|G_TEXTURE_GEN);
+    compare(2,G_LIGHTING|G_LIGHTING_POSITIONAL);
+    // A new native tick explicitly discards all retained command-position keys.
+    clear();
+    const auto beforeTick=candidate.mPreparedLightingMisses;
+    compare(0,G_LIGHTING);
+    const bool tickInvalidated=candidate.mPreparedLightingMisses>beforeTick;
+    // A mesh reached at a different command ordinal must share lighting only
+    // when its complete input key and current source bytes still match.
+    const bool savedAddressExperiment=mmvr::lightingAddressExperiment;
+    const bool savedAddressReference=mmvr::lightingAddressReference;
+    mmvr::lightingAddressExperiment=true;mmvr::lightingAddressReference=false;
+    clear();compare(0,G_LIGHTING);
+    const auto beforeAddressReuse=candidate.mPreparedLightingHits;
+    compare(0,G_LIGHTING,0,37);
+    const bool addressReused=candidate.mPreparedLightingHits==beforeAddressReuse+1;
+    const auto beforeAddressMutation=candidate.mPreparedLightingMisses;
+    source[0].n.n[0]++;compare(0,G_LIGHTING,0,38);
+    source[1].v.ob[0]++;compare(0,G_LIGHTING,0,39);
+    source[2].v.tc[0]++;compare(0,G_LIGHTING,0,40);
+    const bool addressSourceInvalidated=candidate.mPreparedLightingMisses==beforeAddressMutation+3;
+    const auto beforeAddressLight=candidate.mPreparedLightingMisses;
+    compare(0,G_LIGHTING,1,41);
+    const bool addressLightInvalidated=candidate.mPreparedLightingMisses==beforeAddressLight+1;
+    compare(0,G_LIGHTING|G_TEXTURE_GEN,0,42);
+    const auto beforeAddressLookat=candidate.mPreparedLightingMisses;
+    compare(0,G_LIGHTING|G_TEXTURE_GEN,2,43);
+    const bool addressLookatInvalidated=candidate.mPreparedLightingMisses==beforeAddressLookat+1;
+    compare(0,G_LIGHTING|G_LIGHTING_POSITIONAL,0,44);
+    const auto beforeAddressPosition=candidate.mPreparedLightingMisses;
+    compare(0,G_LIGHTING|G_LIGHTING_POSITIONAL,3,45);
+    const bool addressPositionInvalidated=candidate.mPreparedLightingMisses==beforeAddressPosition+1;
+    clear();
+    const auto beforeAddressTick=candidate.mPreparedLightingMisses;
+    compare(0,G_LIGHTING,0,46);
+    const bool addressTickInvalidated=candidate.mPreparedLightingMisses==beforeAddressTick+1;
+    const auto beforeAddressNewTickReuse=candidate.mPreparedLightingHits;
+    compare(0,G_LIGHTING,0,47);
+    const bool addressNewTickReused=candidate.mPreparedLightingHits==beforeAddressNewTickReuse+1;
+    mmvr::lightingAddressExperiment=savedAddressExperiment;
+    mmvr::lightingAddressReference=savedAddressReference;
+    if(!exact||!addressReused||!addressSourceInvalidated||!addressLightInvalidated||
+       !addressLookatInvalidated||!addressPositionInvalidated||!addressTickInvalidated||!addressNewTickReused)
+        throw std::runtime_error("Address lighting cache differential failed");
+    // Same three model/eye variants as the real native/left/right replay, then
+    // several interpolated replays of the unchanged display list.
+    Interpreter prior;
+    prior.mSharedScenePreparation=true;
+    prior.mFbActive=true;
+    prior.mActiveFrameBuffer=prior.mFrameBuffers.end();
+    prior.mCurDimensions.width=320;prior.mCurDimensions.height=240;
+    // Both paths use the same three-way cache. The prior path discards it at
+    // every render; the candidate retains it for a five-render native tick.
+    constexpr int rounds=2000;
+    auto run=[&](Interpreter& probe,bool retainWithinTick){
+        uint64_t checksum=0;
+        const auto begin=std::chrono::steady_clock::now();
+        for(int frame=0;frame<rounds;++frame){
+            if(!retainWithinTick||frame%5==0)
+                for(auto& ways:probe.mPreparedLighting)for(auto& entry:ways)entry.vertices=nullptr;
+            for(int eye=0;eye<3;++eye){
+                configure(probe,eye,G_LIGHTING);
+                probe.mSceneVertexBatch=0;
+                probe.GfxSpVertexImpl(count,0,source.data(),true);
+                checksum+=probe.mRsp->loaded_vertices[frame%count].color.r;
+            }
+        }
+        const auto elapsed=std::chrono::steady_clock::now()-begin;
+        return std::pair{std::chrono::duration_cast<std::chrono::nanoseconds>(elapsed).count(),checksum};
+    };
+    const auto baseline=run(prior,false);
+    const auto optimized=run(candidate,true);
+    exact &= baseline.second==optimized.second;
+    const char* session=std::getenv("MMVR_SESSION_TOKEN");
+    std::ofstream("native-shared-lighting-cache.json")
+        <<"{\"session\":\""<<(session?session:"")<<"\",\"exact\":"<<exact
+        <<",\"reused\":"<<reused<<",\"sourceInvalidated\":"<<sourceInvalidated
+        <<",\"tickInvalidated\":"<<tickInvalidated
+        <<",\"activeLightInvalidated\":"<<activeLightInvalidated
+        <<",\"texgenLookatInvalidated\":"<<texgenLookatInvalidated
+        <<",\"irrelevantReused\":"<<irrelevantReused
+        <<",\"positionInvalidated\":"<<positionInvalidated
+        <<",\"hits\":"<<candidate.mPreparedLightingHits
+        <<",\"misses\":"<<candidate.mPreparedLightingMisses
+        <<",\"referenceNs\":"<<baseline.first<<",\"candidateNs\":"<<optimized.first<<"}";
+    if(!exact||!reused||!sourceInvalidated||!activeLightInvalidated||!texgenLookatInvalidated||
+       !irrelevantReused||!positionInvalidated||!tickInvalidated)
+        throw std::runtime_error("Shared lighting tick cache differential failed");
+}
diff -ruN a/libultraship/src/fast/interpreter_texture_cache_test.inc b/libultraship/src/fast/interpreter_texture_cache_test.inc
--- a/libultraship/src/fast/interpreter_texture_cache_test.inc	1970-01-01 00:00:00.000000000 +0000
+++ b/libultraship/src/fast/interpreter_texture_cache_test.inc	2026-10-23 06:54:56.119943207 +0000
@@ -0,0 +1,166 @@
+// Included inside namespace Fast. The native probe uses the real cache methods
+// with an isolated recording renderer, never the live game's GPU objects.
+namespace {
+class TextureCacheProbeRenderer final : public GfxRenderingAPI {
+  public:
+    uint32_t created=0;uint64_t selections=0,mirrorSelections=0,uploads=0,draws=0;
+    std::array<uint32_t,SHADER_MAX_TEXTURES> bound{};
+    const char* GetName() override{return "texture-cache-probe";}
+    int GetMaxTextureSize() override{return 4096;}
+    GfxClipParameters GetClipParameters() override{return {false,false};}
+    void UnloadShader(ShaderProgram*) override{}
+    void LoadShader(ShaderProgram*) override{}
+    void ClearShaderCache() override{}
+    ShaderProgram* CreateAndLoadNewShader(uint64_t,uint64_t) override{return nullptr;}
+    ShaderProgram* LookupShader(uint64_t,uint64_t) override{return nullptr;}
+    void ShaderGetInfo(ShaderProgram*,uint8_t* inputs,bool textures[2]) override{*inputs=0;textures[0]=textures[1]=false;}
+    uint32_t NewTexture() override{return ++created;}
+    void SelectTexture(int tile,uint32_t texture) override{++selections;bound.at(tile)=texture;}
+    void UploadTexture(const uint8_t*,uint32_t,uint32_t) override{++uploads;}
+    void SetSamplerParameters(int,bool,uint32_t,uint32_t) override{}
+    void SetDepthTestAndMask(bool,bool) override{}
+    void SetCurrentPrimDepth(float) override{}
+    void SetZmodeDecal(bool) override{}
+    void SetViewport(int,int,int,int) override{}
+    void SetScissor(int,int,int,int) override{}
+    void SetUseAlpha(bool) override{}
+    void DrawTriangles(float*,size_t,size_t) override{++draws;}
+    void Init() override{}
+    void OnResize() override{}
+    void StartFrame() override{}
+    void EndFrame() override{}
+    void FinishRender() override{}
+    int CreateFramebuffer() override{return 0;}
+    void UpdateFramebufferParameters(int,uint32_t,uint32_t,uint32_t,bool,bool,bool,bool) override{}
+    void StartDrawToFramebuffer(int,float) override{}
+    void CopyFramebuffer(int,int,int,int,int,int,int,int,int,int) override{}
+    void ClearFramebuffer(bool,bool) override{}
+    void ReadFramebufferToCPU(int,uint32_t,uint32_t,uint16_t*) override{}
+    void ResolveMSAAColorBuffer(int,int) override{}
+    std::unordered_map<std::pair<float,float>,uint16_t,hash_pair_ff>
+        GetPixelDepth(int,const std::set<std::pair<float,float>>&) override{return {};}
+    void* GetFramebufferTextureId(int) override{return nullptr;}
+    void SelectTextureFb(int framebuffer) override{++mirrorSelections;bound[0]=0xf0000000u|uint32_t(framebuffer);}
+    void DeleteTexture(uint32_t) override{}
+    void SetTextureFilter(FilteringMode) override{}
+    FilteringMode GetTextureFilter() override{return FILTER_THREE_POINT;}
+    void SetSrgbMode() override{}
+    ImTextureID GetTextureById(int) override{return (ImTextureID)0;}
+};
+}
+
+void Interpreter::WriteTextureCacheDiagnostics(const char* path) const {
+    if(!mTextureCacheDiagnosticsEnabled||!path)return;
+    const char* session=std::getenv("MMVR_SESSION_TOKEN");
+    const auto& counts=mTextureCacheDiagnostics;
+    std::ofstream(path)<<"{\"session\":\""<<(session?session:"")<<"\",\"currentHits\":"<<counts.currentHits
+        <<",\"mapHits\":"<<counts.mapHits<<",\"misses\":"<<counts.misses
+        <<",\"lookups\":"<<(counts.currentHits+counts.mapHits+counts.misses)
+        <<",\"entries\":"<<mTextureCache.map.size()
+        <<",\"sharedLightingHits\":"<<mPreparedLightingHits
+        <<",\"sharedLightingMisses\":"<<mPreparedLightingMisses<<"}";
+}
+
+void Interpreter::VerifyTextureCacheFastPath() {
+    const char* diagnostic=std::getenv("MMVR_NATIVE_TEST");
+    if(!diagnostic||std::strcmp(diagnostic,"1")!=0)return;
+    TextureCacheProbeRenderer backend;
+    Interpreter probe;probe.mRapi=&backend;
+    // Production Init reserves these buckets so LRU map iterators remain valid.
+    probe.mTextureCache.map.reserve(TEXTURE_CACHE_MAX_SIZE);
+    std::array<uint8_t,TEXTURE_CACHE_MAX_SIZE+2> addresses{};
+    std::array<uint8_t,4> palettes{};
+    TextureCacheKey base{addresses.data(),{nullptr,nullptr},G_IM_FMT_RGBA,G_IM_SIZ_16b,0,16};
+    const bool firstMiss=!probe.TextureCacheLookup(0,base);
+    const uint32_t baseId=backend.bound[0];
+    const auto firstCounts=probe.mTextureCacheDiagnostics;
+    const auto firstSelections=backend.selections;
+    bool sameKey=firstMiss&&baseId!=0;
+    constexpr unsigned repeats=1000;
+    for(unsigned i=0;i<repeats;++i)
+        sameKey&=probe.TextureCacheLookup(0,base)&&backend.bound[0]==baseId&&probe.mTextureCache.map.size()==1;
+    sameKey&=probe.mTextureCacheDiagnostics.currentHits==firstCounts.currentHits+repeats&&
+        probe.mTextureCacheDiagnostics.mapHits==firstCounts.mapHits&&
+        probe.mTextureCacheDiagnostics.misses==firstCounts.misses&&backend.selections==firstSelections+repeats;
+
+    // Every field apart from the unchanged address must remain part of identity.
+    std::array<TextureCacheKey,6> variants;variants.fill(base);
+    variants[0].palette_addrs[0]=palettes.data();variants[1].palette_addrs[1]=palettes.data()+1;
+    variants[2].fmt=G_IM_FMT_IA;variants[3].siz=G_IM_SIZ_8b;
+    variants[4].palette_index=1;variants[5].size_bytes=32;
+    bool keyDifferences=true;std::set<uint32_t> variantIds{baseId};
+    for(const auto& key:variants){
+        keyDifferences&=!probe.TextureCacheLookup(0,key)&&probe.mRenderingState.mTextures[0]->first==key;
+        keyDifferences&=variantIds.insert(backend.bound[0]).second;
+    }
+    keyDifferences&=probe.mTextureCache.map.size()==variants.size()+1;
+    const auto beforeMapHit=probe.mTextureCacheDiagnostics;
+    bool mapHit=probe.TextureCacheLookup(0,base)&&backend.bound[0]==baseId&&
+        probe.mTextureCacheDiagnostics.mapHits==beforeMapHit.mapHits+1&&
+        probe.mTextureCacheDiagnostics.currentHits==beforeMapHit.currentHits;
+
+    TextureCacheKey other=base;other.texture_addr=addresses.data()+1;
+    probe.TextureCacheLookup(1,other);
+    bool lruRefresh=probe.mTextureCache.lru.back().it->first==other;
+    probe.TextureCacheLookup(0,base);
+    lruRefresh&=probe.mTextureCache.lru.back().it->first==base;
+
+    // Exercise ImportTexture's real framebuffer-mirror branch. It leaves the
+    // current cache node intact, so a following fast hit MUST rebind the texture.
+    probe.mRdp->texture_tile[0].tmem_index=0;
+    probe.mRdp->texture_tile[0].fmt=base.fmt;probe.mRdp->texture_tile[0].siz=base.siz;
+    probe.mRdp->loaded_texture[0].addr=base.texture_addr;
+    probe.RegisterFbTexture(base.texture_addr,7);
+    auto* beforeMirrorNode=probe.mRenderingState.mTextures[0];
+    probe.ImportTexture(0,0,false);
+    bool mirrorRebind=backend.mirrorSelections==1&&backend.bound[0]!=baseId&&
+        probe.mRenderingState.mTextures[0]==beforeMirrorNode;
+    probe.UnregisterFbTexture(base.texture_addr);
+    const auto beforeRebind=backend.selections;
+    const auto beforeMirrorHit=probe.mTextureCacheDiagnostics.currentHits;
+    mirrorRebind&=probe.TextureCacheLookup(0,base)&&backend.bound[0]==baseId&&
+        backend.selections==beforeRebind+1&&probe.mTextureCacheDiagnostics.currentHits==beforeMirrorHit+1;
+
+    auto* otherNode=probe.mRenderingState.mTextures[1];
+    probe.TextureCacheDelete(base.texture_addr);
+    bool deleteReload=probe.mRenderingState.mTextures[0]==nullptr&&
+        probe.mRenderingState.mTextures[1]==otherNode&&probe.mTextureCache.map.size()==1;
+    for(const auto& entry:probe.mTextureCache.map)deleteReload&=entry.first.texture_addr!=base.texture_addr;
+    deleteReload&=!probe.TextureCacheLookup(0,base)&&probe.mRenderingState.mTextures[0]->first==base;
+    for(int slot=0;slot<SHADER_MAX_TEXTURES;++slot)probe.TextureCacheLookup(slot,base);
+    probe.TextureCacheClear();
+    bool clearReload=probe.mTextureCache.map.empty()&&probe.mTextureCache.lru.empty();
+    for(auto* current:probe.mRenderingState.mTextures)clearReload&=current==nullptr;
+    clearReload&=!probe.TextureCacheLookup(0,base)&&probe.mRenderingState.mTextures[0]->first==base;
+
+    probe.TextureCacheClear();
+    probe.TextureCacheLookup(0,base);
+    for(size_t i=1;i<TEXTURE_CACHE_MAX_SIZE;++i){
+        TextureCacheKey key=base;key.texture_addr=addresses.data()+i;
+        probe.TextureCacheLookup(1,key);
+    }
+    bool eviction=probe.mTextureCache.map.size()==TEXTURE_CACHE_MAX_SIZE&&
+        probe.mRenderingState.mTextures[0]&&probe.mRenderingState.mTextures[0]->first==base;
+    TextureCacheKey newest=base;newest.texture_addr=addresses.data()+TEXTURE_CACHE_MAX_SIZE;
+    eviction&=!probe.TextureCacheLookup(1,newest)&&probe.mRenderingState.mTextures[0]==nullptr&&
+        !probe.mTextureCache.map.contains(base)&&probe.mTextureCache.map.size()==TEXTURE_CACHE_MAX_SIZE;
+    eviction&=!probe.TextureCacheLookup(0,base)&&probe.mRenderingState.mTextures[0]->first==base;
+
+    bool invariants=probe.mTextureCache.map.size()==probe.mTextureCache.lru.size();
+    std::set<uint32_t> liveIds;
+    for(const auto& entry:probe.mTextureCache.map){
+        invariants&=liveIds.insert(entry.second.texture_id).second;
+        invariants&=entry.second.lru_location!=probe.mTextureCache.lru.end()&&
+            &*entry.second.lru_location->it==&entry;
+    }
+    const bool isolated=backend.uploads==0&&backend.draws==0;
+    const char* session=std::getenv("MMVR_SESSION_TOKEN");const auto& counts=probe.mTextureCacheDiagnostics;
+    std::ofstream("native-texture-cache.json")<<"{\"session\":\""<<(session?session:"")<<"\",\"repeats\":"<<repeats
+        <<",\"sameKey\":"<<sameKey<<",\"keyDifferences\":"<<keyDifferences<<",\"mapHit\":"<<mapHit
+        <<",\"lruRefresh\":"<<lruRefresh<<",\"mirrorRebind\":"<<mirrorRebind<<",\"deleteReload\":"<<deleteReload
+        <<",\"clearReload\":"<<clearReload<<",\"eviction\":"<<eviction<<",\"invariants\":"<<invariants
+        <<",\"isolated\":"<<isolated<<",\"currentHits\":"<<counts.currentHits<<",\"mapHits\":"<<counts.mapHits
+        <<",\"misses\":"<<counts.misses<<"}";
+    if(!sameKey||!keyDifferences||!mapHit||!lruRefresh||!mirrorRebind||!deleteReload||!clearReload||!eviction||!invariants||!isolated)
+        throw std::runtime_error("Native texture-cache fast-path regression failed");
+}
