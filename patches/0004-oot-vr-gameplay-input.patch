index 00000000..a0cb4c73
--- /dev/null
+++ b/soh/soh/VR/OotVR.cpp
@@ -0,0 +1,80 @@
+#include "OotVR.h"
+
+#include "global.h"
+
+#ifdef MMVR_ENABLE
+#include "runtime.h"
+
+namespace {
+bool sPadActive = false;
+int sGameplayScene = -1;
+OSContPad sPreviousVrPad{};
+
+void UpdatePadEdges(Input* input) {
+    input->press.button = input->cur.button & ~input->prev.button;
+    input->rel.button = input->prev.button & ~input->cur.button;
+    input->press.stick_x = static_cast<int8_t>(input->cur.stick_x - input->prev.stick_x);
+    input->press.stick_y = static_cast<int8_t>(input->cur.stick_y - input->prev.stick_y);
+    input->press.right_stick_x = static_cast<int8_t>(input->cur.right_stick_x - input->prev.right_stick_x);
+    input->press.right_stick_y = static_cast<int8_t>(input->cur.right_stick_y - input->prev.right_stick_y);
+    PadUtils_UpdateRelXY(input);
+    PadUtils_UpdateRelRXY(input);
+}
+} // namespace
+
+extern "C" void OotVR_Init(void) {
+    sPadActive = false;
+    sGameplayScene = -1;
+    sPreviousVrPad = {};
+}
+
+extern "C" void OotVR_Shutdown(void) {
+    sPadActive = false;
+}
+
+extern "C" int OotVR_Active(void) {
+    return mmvr::StereoActive();
+}
+
+extern "C" void OotVR_UpdateInput(Input* input) {
+    const mmvr::Pad pad = mmvr::ConsumePad();
+    if (!pad.active) {
+        if (sPadActive) {
+            input->prev = sPreviousVrPad;
+            UpdatePadEdges(input);
+            sPadActive = false;
+        }
+        return;
+    }
+
+    input->prev = sPadActive ? sPreviousVrPad : input->cur;
+    input->cur.button = pad.buttons;
+    input->cur.stick_x = pad.x;
+    input->cur.stick_y = pad.y;
+    input->cur.right_stick_x = pad.rightX;
+    input->cur.right_stick_y = pad.rightY;
+    input->cur.gyro_x = 0;
+    input->cur.gyro_y = 0;
+    input->cur.err_no = 0;
+    UpdatePadEdges(input);
+    sPreviousVrPad = input->cur;
+    sPadActive = true;
+}
+
+extern "C" void OotVR_SetGameplayScene(int gameplay) {
+    const int nextScene = gameplay != 0;
+    if (sGameplayScene == nextScene) {
+        return;
+    }
+    sGameplayScene = nextScene;
+    mmvr::SetScene(nextScene, nullptr, nullptr);
+}
+#else
+extern "C" void OotVR_Init(void) {}
+extern "C" void OotVR_Shutdown(void) {}
+extern "C" int OotVR_Active(void) {
+    return 0;
+}
+extern "C" void OotVR_UpdateInput(Input*) {}
+extern "C" void OotVR_SetGameplayScene(int) {}
+#endif
